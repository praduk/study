{"id": "a664d3de442e46dd9d3b5a86e87535ce", "card_id": "group-definition::statement", "entry_id": "group-definition", "mode": "statement", "started_at": "2026-09-04T09:05:48.671725+00:00", "attempt": "A group $G$ is a set along with a function $\\cdot:G\\times G\\to G$ such that\n1. (ab)c = a(bc)\n2. $\\exists e\\in G, \\forall g\\in G, eg=g$\n3. $\\forall g\\in G, \\exists g^{-1}\\in G, g^{-1}g = e$.", "confidence": 3, "elapsed_ms": 135891, "overt": true, "hints_used": 0, "graded_at": "2026-09-04T09:07:15.940367+00:00", "grade": 3, "schedule": {"due_at": "2026-09-08T09:07:15.940367+00:00", "last_reviewed_at": "2026-09-04T09:07:15.940367+00:00", "last_grade": 3, "last_elapsed_ms": 135891, "stability_days": 4.0, "difficulty": 4.65, "repetitions": 1, "lapses": 0, "last_confidence": 3, "last_calibration": 0}}
